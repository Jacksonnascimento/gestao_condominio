# Copie este arquivo para .env (na raiz do repositório) e preencha. O .env NÃO vai para o git.
# A API lê o .env sozinha ao subir, rodando da raiz ou da pasta api/.

# Servidor PostgreSQL. No desenvolvimento, o container que já existe na porta 5444.
DB_HOST=localhost
DB_PORT=5444
DB_USER=admin
DB_PASSWORD=

# Clientes atendidos, cada um com o seu banco: identificador:banco[:dominio adicional...], separados por vírgula.
# O identificador é o subdomínio (modelo.localhost, api.modelo.localhost). O banco que não existir é criado na
# subida, já com as migrações. Vazia, a instalação atende um cliente só, no banco de DB_NAME.
CLIENTES=modelo:condigtal_modelo:localhost,exemplo:condigtal_exemplo
# DB_NAME=condigtal

# Primeiro acesso: num banco de cliente sem ninguém cadastrado, a subida cria este administrador.
ADMINISTRADOR_INICIAL_EMAIL=
ADMINISTRADOR_INICIAL_SENHA=
ADMINISTRADOR_INICIAL_CPF=
ADMINISTRADOR_INICIAL_NOME=Administrador

# E-mail de envio (senha de app do Gmail). Com EMAIL_ATIVO=false nada é enviado: o conteúdo vai para o log.
EMAIL_ATIVO=false
MAIL_USERNAME=condigtalgestaodecondominio@gmail.com
MAIL_PASSWORD=

# Login da API: segredo que assina os tokens (pelo menos 32 caracteres; gere um aleatório por instalação).
TOKEN_SEGREDO=
# TOKEN_VALIDADE_MINUTOS=120
# TOKEN_RENOVACAO_VALIDADE_DIAS=30

# Endereços do sistema web (Next.js). {cliente} vira o identificador do cliente.
CORS_ORIGENS=http://localhost:3000,http://*.localhost:3000
WEB_URL_PUBLICA=http://{cliente}.localhost:3000
