# Copie para .env.local se precisar mudar algo; sem ele, os valores abaixo já servem para o desenvolvimento.

# Vazio: o navegador chama a API pelo próprio endereço da tela (/api/v1/...) e o Next repassa à API.
# Assim a API recebe o endereço do condomínio (modelo.localhost:3000) e escolhe o banco por ele.
NEXT_PUBLIC_API_URL=

# Onde o servidor do Next encontra a API. No Docker, o nome do serviço (http://condigtal-api:8080).
API_INTERNA_URL=http://localhost:8080
